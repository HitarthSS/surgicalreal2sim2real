FROM med3d:cu128
USER root
ENV PIP_CONSTRAINT="" MAX_JOBS=8 TORCH_CUDA_ARCH_LIST=12.0 FORCE_CUDA=1
RUN python -m pip install --no-cache-dir 'numpy<2' 'setuptools<81' ninja 'kornia==0.7.0' 'evotorch==0.6.1' 'filterpy==1.4.5' iopath 'gpytorch==1.14' scikit-fmm networkx scikit-image osqp rosbags 'newton==1.3.0' pycocotools psutil ftfy regex einops timm hydra-core omegaconf pyquaternion imageio trimesh pyglet
RUN python -m pip install --no-cache-dir --no-build-isolation FastGeodis 'git+https://github.com/facebookresearch/pytorch3d.git@v0.7.9'
RUN git clone https://github.com/facebookresearch/sam3.git /opt/ismr_sam3 && cd /opt/ismr_sam3 && git checkout 660a5e9e1b8b4c02c0ad97229b88a09a6e4ff5b7 && python -m pip install --no-cache-dir --no-deps -e .
RUN python - <<'PY'
import torch,cv2,numpy,scipy,pytorch3d,FastGeodis,evotorch,filterpy,gpytorch,nvdiffrast,newton
from sam3.model_builder import build_sam3_image_model
from sam3.model.sam3_image_processor import Sam3Processor
print('CPU import preflight',torch.__version__,torch.version.cuda,numpy.__version__)
assert tuple(int(x) for x in torch.version.cuda.split('.')[:2]) >= (12,8)
PY
ENV PYTHONPATH=/opt/ismr_sam3
WORKDIR /workspace
